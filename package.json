{
  "name": "aigc-ecommerce-video-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "电商场景 AIGC 带货视频生成系统 Monorepo",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @aigc-video/web dev",
    "dev:api": "pnpm --filter @aigc-video/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "stylelint": "stylelint \"apps/web/src/**/*.{css,scss}\"",
    "prepare": "husky"
  },
  "keywords": [
    "aigc",
    "ecommerce",
    "video",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
